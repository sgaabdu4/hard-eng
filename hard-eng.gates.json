{
  "version": 1,
  "scan_git_history": false,
  "packages": [
    {
      "name": "hard-eng",
      "path": ".",
      "language": "python",
      "sources": ["hard_eng"],
      "checks": [
        {"name": "format", "role": "format", "tool": "ruff", "command": ["format", "--check", "."]},
        {"name": "lint", "role": "lint", "tool": "ruff", "command": ["check", "."]},
        {"name": "types", "role": "types", "tool": "pyrefly", "command": ["check", "--min-severity", "info"]},
        {"name": "tests", "role": "tests", "tool": "pytest", "command": ["--cov=hard_eng", "--cov-report=json:coverage/coverage.json", "--junitxml=coverage/junit.xml"], "report": {"type": "python-tests", "tests": "coverage/junit.xml", "coverage": "coverage/coverage.json", "minimum_tests": 1}},
        {"name": "dead-code", "role": "dead-code", "tool": "vulture", "command": ["hard_eng", "tests", "--min-confidence", "60"]},
        {"name": "duplicates", "role": "duplicates", "tool": "jscpd", "command": ["hard_eng", "tests", "--format", "python", "--threshold", "0", "--max-size", "100mb", "--max-lines", "1000000", "--reporters", "json", "--output", "coverage/jscpd"], "report": {"type": "jscpd", "path": "coverage/jscpd/jscpd-report.json"}},
        {"name": "dependencies", "role": "dependencies", "tool": "deptry", "command": ["."]},
        {"name": "imports", "role": "imports", "tool": "lint-imports", "command": []}
      ]
    }
  ],
  "shared": [
    {"name": "shell", "role": "shell", "tool": "shellcheck", "command": ["setup.sh"]},
    {"name": "workflows", "role": "workflows", "tool": "actionlint", "command": []},
    {"name": "workflow-security", "role": "workflow-security", "tool": "zizmor", "command": ["--no-progress", "--strict-collection", "--persona", "auditor", ".github/workflows"]},
    {"name": "lockfile", "role": "lockfiles", "command": ["uv", "lock", "--check"]},
    {"name": "secrets-files", "role": "secrets-files", "tool": "gitleaks", "command": ["dir", ".", "--redact=100", "--no-banner"]},
    {"name": "vulnerabilities", "role": "vulnerabilities", "tool": "osv-scanner", "command": ["scan", "source", "--lockfile=uv.lock", "--all-packages", "--format=json", "--output-file=coverage/osv.json"], "report": {"type": "osv", "path": "coverage/osv.json"}},
    {"name": "security", "role": "security", "tool": "semgrep", "command": ["scan", "--config", "security", "--error", "--strict", "--json", "--output", "coverage/semgrep.json", "hard_eng"], "report": {"type": "semgrep", "path": "coverage/semgrep.json"}}
  ]
}
