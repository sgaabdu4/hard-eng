{
  "schema_version": 1,
  "enforcement": {
    "schema_version": 1,
    "required_paths": [
      ".github/workflows/check-skill-contracts.yml",
      "scripts/enforcement_policy.pl",
      "scripts/git-hooks/publish-gate.sh",
      "scripts/hooks/agent-hook.sh"
    ]
  },
  "families": {
    "targeted": ["python3", "scripts/check-skill-contracts.py"],
    "typecheck": ["node_modules/.bin/tsc", "--project", "jsconfig.json", "--noEmit"],
    "staged": ["node_modules/.bin/biome", "check", "--staged", "--no-errors-on-unmatched"],
    "format": ["node_modules/.bin/biome", "format", "."],
    "lint": ["node_modules/.bin/biome", "lint", "."],
    "tests": [
      "node",
      "--test",
      "skills/appwrite-backend/scripts/appwrite-query-contract.test.mjs",
      "skills/appwrite-backend/scripts/appwrite-schema-guard.test.mjs",
      "skills/appwrite-backend/scripts/skill-safety-contract.test.mjs"
    ],
    "fallow": ["node_modules/.bin/fallow", "--fail-on-issues", "--format", "json", "--quiet"],
    "python-types": ["node_modules/.bin/pyright"],
    "skill-contracts": ["python3", "scripts/check-skill-contracts.py"],
    "managed-skills": ["node", "scripts/check-managed-skills.js"],
    "design": ["node", "skills/deterministic-checks/scripts/check-design-md.js", "DESIGN.md"],
    "enforcement": ["perl", "scripts/enforcement_policy.pl", "check", "."]
  },
  "phases": {
    "commit": ["staged", "enforcement"],
    "push": [
      "typecheck",
      "format",
      "lint",
      "tests",
      "fallow",
      "python-types",
      "skill-contracts",
      "managed-skills",
      "design",
      "enforcement"
    ],
    "ci": [
      "typecheck",
      "format",
      "lint",
      "tests",
      "fallow",
      "python-types",
      "skill-contracts",
      "managed-skills",
      "design",
      "enforcement"
    ]
  }
}
