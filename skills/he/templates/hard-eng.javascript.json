{
  "version": 1,
  "packages": [{
    "name": "app", "path": ".", "language": "javascript", "sources": ["src"],
    "checks": [
      {"name": "format-lint", "role": "format-lint", "tool": "biome", "command": ["ci", ".", "--error-on-warnings"]},
      {"name": "types", "role": "types", "command": ["npm", "run", "typecheck"]},
      {"name": "tests", "role": "tests", "command": ["npm", "run", "test:coverage"], "report": {"type": "lcov-tests", "tests": "coverage/junit.xml", "coverage": "coverage/lcov.info"}},
      {"name": "dead-code-duplicates", "role": "dead-code-duplicates", "tool": "fallow", "command": ["--only", "dead-code,dupes", "--max-file-size", "0", "--fail-on-issues", "--format", "json", "--output-file", "coverage/fallow.json"], "report": {"type": "fallow", "path": "coverage/fallow.json"}}
    ]
  }],
  "shared": [
    {"name": "lockfile", "role": "lockfiles", "command": ["npm", "ci", "--dry-run", "--ignore-scripts", "--no-audit", "--no-fund"]},
    {"name": "secrets-files", "role": "secrets-files", "tool": "gitleaks", "command": ["dir", ".", "--redact=100", "--no-banner"]},
    {"name": "secrets-history", "role": "secrets-history", "tool": "gitleaks", "command": ["git", ".", "--redact=100", "--no-banner", "--log-opts=--all"]},
    {"name": "vulnerabilities", "role": "vulnerabilities", "tool": "osv-scanner", "command": ["scan", "source", "--lockfile=package-lock.json", "--all-packages", "--format=json", "--output-file=coverage/osv.json"], "report": {"type": "osv", "path": "coverage/osv.json"}},
    {"name": "security", "role": "security", "tool": "semgrep", "command": ["scan", "--config", "p/javascript", "--config", "p/typescript", "--error", "--strict", "--json", "--output", "coverage/semgrep.json", "src"], "report": {"type": "semgrep", "path": "coverage/semgrep.json"}}
  ]
}
