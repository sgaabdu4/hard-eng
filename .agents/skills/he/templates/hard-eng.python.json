{
  "version": 1,
  "packages": [{
    "name": "app", "path": ".", "language": "python", "sources": ["src"],
    "checks": [
      {"name": "format", "role": "format", "tool": "ruff", "command": ["format", "--check", "."]},
      {"name": "lint", "role": "lint", "tool": "ruff", "command": ["check", ".", "--extend-select", "C901,PLR0912,PLR0915"]},
      {"name": "types", "role": "types", "tool": "pyrefly", "command": ["check", "--min-severity", "info"]},
      {"name": "tests", "role": "tests", "tool": "pytest", "command": ["--cov=src", "--cov-branch", "--cov-report=json:coverage/coverage.json", "--junitxml=coverage/junit.xml"], "report": {"type": "python-tests", "tests": "coverage/junit.xml", "coverage": "coverage/coverage.json"}},
      {"name": "dead-code", "role": "dead-code", "tool": "vulture", "command": ["src", "tests", "--min-confidence", "60"]},
      {"name": "duplicates", "role": "duplicates", "tool": "jscpd", "command": ["src", "tests", "--format", "python", "--threshold", "0", "--max-size", "100mb", "--max-lines", "1000000", "--reporters", "json", "--output", "coverage/jscpd"], "report": {"type": "jscpd", "path": "coverage/jscpd/jscpd-report.json"}},
      {"name": "dependencies", "role": "dependencies", "tool": "deptry", "command": ["."]},
      {"name": "imports", "role": "imports", "tool": "lint-imports", "command": []}
    ]
  }],
  "shared": [
    {"name": "lockfile", "role": "lockfiles", "command": ["uv", "sync", "--locked"]},
    {"name": "secrets-files", "role": "secrets-files", "tool": "gitleaks", "command": ["dir", ".", "--redact=100", "--no-banner"]},
    {"name": "secrets-history", "role": "secrets-history", "tool": "gitleaks", "command": ["git", ".", "--redact=100", "--no-banner", "--log-opts=--all"]},
    {"name": "vulnerabilities", "role": "vulnerabilities", "tool": "osv-scanner", "command": ["scan", "source", "--lockfile=uv.lock", "--all-packages", "--format=json", "--output-file=coverage/osv.json"], "report": {"type": "osv", "path": "coverage/osv.json"}},
    {"name": "security", "role": "security", "tool": "semgrep", "command": ["scan", "--config", "p/python", "--error", "--strict", "--json", "--output", "coverage/semgrep.json", "src"], "report": {"type": "semgrep", "path": "coverage/semgrep.json"}}
  ]
}
