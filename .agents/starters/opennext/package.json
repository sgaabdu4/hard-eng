{
  "scripts": {
    "lint": null,
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false ./cloudflare-env.d.ts && biome format --write ./cloudflare-env.d.ts",
    "test:coverage": "bun test --path-ignore-patterns='performance/**' --coverage --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=coverage/junit.xml",
    "test:performance": "bun test ./performance --reporter=junit --reporter-outfile=coverage/performance.xml",
    "lint:boundaries": "fallow architecture --boundaries --fail-on-issues"
  },
  "dependencies": {
    "@opennextjs/cloudflare": null
  },
  "devDependencies": {
    "@eslint/eslintrc": null,
    "eslint": null,
    "eslint-config-next": null,
    "@cloudflare/workers-types": "latest",
    "@opennextjs/cloudflare": "latest",
    "@types/bun": "latest",
    "@biomejs/biome": "latest"
  },
  "overrides": {
    "sharp": ">=0.35.5"
  }
}
